];

var MISSING_OPTIONS = ['Вспахать', 'Посадить', 'Полить'];

/* ==================== ЗВУКИ ==================== */
var audioCtx = null;
function playTone(freq, duration, type) {
  if (!state.soundOn) return;
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    var osc = audioCtx.createOscillator();
    var gain = audioCtx.createGain();
    osc.type = type || 'sine';
    osc.frequency.value = freq;
    gain.gain.value = 0.08;
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
    osc.stop(audioCtx.currentTime + duration);
  } catch(e) {}
}
function soundClick() { playTone(700, 0.05, 'sine'); }
function soundWin() { playTone(800, 0.12); setTimeout(function(){ playTone(1000, 0.12); }, 100); setTimeout(function(){ playTone(1400, 0.25); }, 220); }
function soundFail() { playTone(180, 0.25, 'sawtooth'); }
function soundLocked() { playTone(300, 0.15, 'square'); }

/* ==================== УТИЛИТЫ ==================== */
function shuffle(arr) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}

function saveProgress() {
  try {
    localStorage.setItem('pole_stars', JSON.stringify(state.stars));
    localStorage.setItem('pole_theme', state.theme);
    localStorage.setItem('pole_sound', state.soundOn ? '1' : '0');
    localStorage.setItem('pole_streak', state.streak);
    localStorage.setItem('pole_gems', state.gems);
  } catch(e) {}
}

function loadProgress() {
  try {
    var s = localStorage.getItem('pole_stars');
    if (s) state.stars = JSON.parse(s);
    var t = localStorage.getItem('pole_theme');
    if (t) { state.theme = t; document.body.className = 'theme-' + t; }
    var so = localStorage.getItem('pole_sound');
    if (so !== null) state.soundOn = so === '1';
    var st = localStorage.getItem('pole_streak');
    if (st) state.streak = parseInt(st);
    var g = localStorage.getItem('pole_gems');
    if (g) state.gems = parseInt(g);
  } catch(e) {}
  while (state.stars.length < LESSONS.length) state.stars.push(0);
}

function isUnlocked(i) {
  if (i === 0) return true;
  return state.stars[i - 1] === 1;
}

/* ==================== НАСТРОЙКИ ==================== */
function setTheme(name) {
  state.theme = name;
  document.body.className = 'theme-' + name;
  saveProgress();
  render();
}

function toggleSound() {
  state.soundOn = !state.soundOn;
  saveProgress();
  render();
}

/* ==================== РЕНДЕР ==================== */
function render() {
  var app = document.getElementById('app');
  if (state.screen === 'map') app.innerHTML = renderMap();
  else if (state.screen === 'settings') app.innerHTML = renderSettings();
  else if (state.screen === 'lesson') app.innerHTML = renderLesson();
  else if (state.screen === 'end') app.innerHTML = renderEnd();
}

function renderTopbar() {
  var hearts = '';
  for (var i = 0; i < 5; i++) hearts += i < state.lives ? '❤️' : '🖤';
  return '<div class="topbar">' +
    '<div class="topbar-item topbar-streak"><span class="topbar-icon">🔥</span>' + state.streak + '</div>' +
    '<div class="topbar-item topbar-hearts">' + hearts + '</div>' +
    '<div class="topbar-item topbar-gems"><span class="topbar-icon">💎</span>' + state.gems + '</div>' +
  '</div>';
}

function renderMap() {
  var html = renderTopbar();
  html += '<h1>Поле</h1>';
  html += '<p class="desc">Учись программировать,<br>выращивая урожай.</p>';

  html += '<div class="map">';

  for (var i = 0; i < LESSONS.length; i++) {
    var L = LESSONS[i];
    var done = state.stars[i] === 1;
    var unlocked = isUnlocked(i);
    var cls = done ? 'done' : (unlocked ? '' : 'locked');
    var icon = done ? '👑' : (unlocked ? L.icon : '🔒');
    var onclick = unlocked ? ' onclick="soundClick(); startLesson(' + i + ')"' : ' onclick="soundLocked()"';

    html += '<div class="node-wrap">' +
      '<button class="node ' + cls + '"' + onclick + '>' + icon +
        (done ? '<span class="node-crown">⭐</span>' : '') +
      '</button>' +
    '</div>';
    html += '<div class="node-label">' + (i + 1) + '. ' + L.title + '</div>';

    if (i < LESSONS.length - 1) {
      html += '<div class="connector ' + (done ? 'done' : '') + '"></div>';
    }
  }

  html += '</div>';

  html += '<button class="secondary" onclick="soundClick(); goSettings()">⚙️ Настройки</button>';

  return html;
}

function goSettings() { state.screen = 'settings'; render(); }
function goMap() { state.screen = 'map'; render(); }

function renderSettings() {
  var html = '<button class="back-btn" onclick="soundClick(); goMap()">← Назад</button>';
  html += '<h2>⚙️ Настройки</h2>';

  html += '<div class="settings-item">' +
    '<div><b>Тема</b><div style="font-size:12px;color:var(--muted)">Цвет оформления</div></div>' +
  '</div>';

  var themes = [
    { id: 'green', name: '🟢 Зелёная' },
    { id: 'dark', name: '🌙 Тёмная' },
    { id: 'purple', name: '🟣 Фиолетовая' }
  ];

  html += '<div class="theme-row">';
  for (var i = 0; i < themes.length; i++) {
    var t = themes[i];
    var active = state.theme === t.id ? ' active' : '';
    html += '<button class="theme-btn' + active + '" onclick="setTheme(\'' + t.id + '\')">' + t.name + '</button>';
  }
  html += '</div>';

  html += '<div class="settings-item" style="margin-top:16px">' +
    '<div><b>Звук</b><div style="font-size:12px;color:var(--muted)">' + (state.soundOn ? 'Включён' : 'Выключен') + '</div></div>' +
    '<button class="theme-btn" style="margin:0;padding:10px 20px" onclick="toggleSound()">' + (state.soundOn ? '🔊' : '🔇') + '</button>' +
  '</div>';

  html += '<button class="danger" style="margin-top:20px" onclick="resetProgress()">Сбросить прогресс</button>';

  return html;
}

function resetProgress() {
  state.stars = [];
  for (var i = 0; i < LESSONS.length; i++) state.stars.push(0);
  state.streak = 0;
  state.gems = 0;
  saveProgress();
  goMap();
}

function renderLesson() {
  var L = LESSONS[state.lesson];
  var total = LESSONS.length;
  var done = state.lesson;

  var progress = Math.round((done / total) * 100);

  var html = '<button class="back-btn" onclick="soundClick(); goMap()">✕ Выйти</button>';
  html += '<div class="progress-bar-wrap"><div class="progress-bar" style="width:' + progress + '%"></div></div>';

  if (state.showExplain) {
    html += '<h1>' + L.icon + ' ' + L.title + '</h1>';
    html += '<div class="explain-card"><h3>📖 Что это?</h3><p>' + L.explain + '</p></div>';
    html += '<div class="example-card">' + L.example + '</div>';
    html += '<button onclick="soundClick(); closeExplain()">Понятно, дальше →</button>';
    return html;
  }

  html += '<h1>' + L.icon + ' ' + L.title + '</h1>';

  var heartsHTML = '';
  for (var h = 0; h < 5; h++) heartsHTML += '<span class="heart' + (h < state.lives ? '' : ' empty') + '">❤️</span>';
  html += '<div class="hearts">' + heartsHTML + '</div>';

  html += '<p>' + L.task + '</p>';

  if (state.hintText) {
    var hintCls = state.errors >= 3 ? 'hint hint-danger' : 'hint';
    html += '<div class="' + hintCls + '"><span class="hint-icon">💡</span><div>' + state.hintText + '</div></div>';
  }

  var body = '';
  if (L.mode === 'build') body = renderBuildMode();
  else if (L.mode === 'missing') body = renderMissingMode();
  else if (L.mode === 'fix') body = renderFixMode();
  else if (L.mode === 'both') {
    if (state.stage === 1) {
      body = '<p class="desc">Этап 1: собери программу</p>' + renderBuildMode();
    } else {
      body = '<p class="desc">Этап 2: исправь ошибку</p>' + renderFixMode();
    }
  }

  html += body;

  if (state.canSkip) {
    html += '<button class="gold" onclick="soundClick(); skipLesson()">Дальше →</button>';
  }

  html += '<button class="secondary" onclick="soundClick(); goMap()">Выйти</button>';

  return html;
}

function renderBuildMode() {
  var slotContent = '';
  if (state.program.length) {
    slotContent = state.program.map(function(b) {
      return '<span class="slot-item">' + BLOCK_ICONS[b] + ' ' + b + '</span>';
    }).join('');
  } else {
    slotContent = 'Нажми на команду ниже';
  }

  var blocksHTML = '';
  for (var i = 0; i < state.currentBlocks.length; i++) {
    var b = state.currentBlocks[i];
    blocksHTML += '<div class="block" onclick="soundClick(); addBlock(\'' + b + '\')">' +
      '<span class="block-icon">' + BLOCK_ICONS[b] + '</span>' + b +
    '</div>';
  }

  return '<div class="slot' + (state.program.length ? ' filled' : '') + '">' + slotContent + '</div>' +
    blocksHTML +
    '<button onclick="soundClick(); checkBuild()">Проверить ✓</button>';
}

function renderMissingMode() {
  var L = LESSONS[state.lesson];
  var html = '';
  html += '<div class="program-line">' + BLOCK_ICONS[L.before] + ' ' + L.before + '</div>';
  html += '<div class="missing-slot">❓ Что тут?</div>';
  html += '<div class="program-line">' + BLOCK_ICONS[L.after] + ' ' + L.after + '</div>';
  html += '<p class="center desc">Что вставить вместо «?»:</p>';
  for (var i = 0; i < MISSING_OPTIONS.length; i++) {
    var b = MISSING_OPTIONS[i];
    html += '<div class="block" onclick="soundClick(); chooseMissing(\'' + b + '\')">' +
      '<span class="block-icon">' + BLOCK_ICONS[b] + '</span>' + b +
    '</div>';
  }
  return html;
}

function renderFixMode() {
  var html = '';
  for (var i = 0; i < state.fixProgram.length; i++) {
    var b = state.fixProgram[i];
    html += '<div class="program-line clickable" onclick="soundClick(); fixBlock(' + i + ')">' +
      BLOCK_ICONS[b] + ' ' + b +
    '</div>';
  }
  html += '<button onclick="soundClick(); checkFix()">Проверить ✓</button>';
  return html;
}

function renderEnd() {
  var got = 0;
  for (var i = 0; i < state.stars.length; i++) if (state.stars[i]) got++;

  var title;
  if (got === LESSONS.length) title = 'Мастер поля';
  else if (got >= 7) title = 'Опытный фермер';
  else if (got >= 4) title = 'Начинающий фермер';
  else title = 'Новичок';

  var html = '<h1>🎉 Поздравляем!</h1>';
  html += '<div class="reward">🏆</div>';
  html += '<p class="center">Ты прошёл все уроки!</p>';

  html += '<div class="stats">' +
    '<div class="stat"><div class="stat-value">' + got + '</div><div class="stat-label">Уроков</div></div>' +
    '<div class="stat"><div class="stat-value">' + state.gems + '</div><div class="stat-label">Кристаллов</div></div>' +
    '<div class="stat"><div class="stat-value">' + state.streak + '</div><div class="stat-label">Серия</div></div>' +
  '</div>';

  html += '<p class="center"><b>Титул: ' + title + '</b></p>';

  html += '<button onclick="soundClick(); goMap()">К карте</button>';
  html += '<button class="secondary" onclick="soundClick(); resetProgress()">Пройти заново</button>';

  return html;
}

/* ==================== ЛОГИКА ==================== */
function startLesson(i) {
  var L = LESSONS[i];
  state.lesson = i;
  state.screen = 'lesson';
  state.lives = 5;
  state.errors = 0;
  state.program = [];
  state.hintText = '';
  state.canSkip = false;
  state.showExplain = true;
  state.stage = 1;
  state.currentBlocks = shuffle(BLOCKS);
  state.fixProgram = L.broken ? L.broken.slice() : (L.stage2Broken ? L.stage2Broken.slice() : []);
  render();
}

function closeExplain() { state.showExplain = false; render(); }

function addBlock(b) {
  state.program.push(b);
  state.hintText = '';
  render();
}

function chooseMissing(b) {
  var L = LESSONS[state.lesson];
  if (b === L.answer) win(); else fail();
}

function fixBlock(i) {
  var cur = state.fixProgram[i];
  var idx = BLOCKS.indexOf(cur);
  var next = BLOCKS[(idx + 1) % BLOCKS.length];
  state.fixProgram[i] = next;
  state.hintText = '';
  render();
}

function checkBuild() {
  var L = LESSONS[state.lesson];
  var answer;
  if (L.mode === 'both') answer = (state.stage === 1) ? L.stage1Answer : L.stage2Answer;
  else answer = L.answer;

  if (JSON.stringify(state.program) === JSON.stringify(answer)) {
    if (L.mode === 'both' && state.stage === 1) {
      state.program = [];
      state.stage = 2;
      state.hintText = '';
      state.errors = 0;
      render();
      return;
    }
    win();
  } else fail();
}

function checkFix() {
  var L = LESSONS[state.lesson];
  var answer = (L.mode === 'both') ? L.stage2Answer : L.answer;
  if (JSON.stringify(state.fixProgram) === JSON.stringify(answer)) win(); else fail();
}

function fail() {
  state.errors++;
  state.lives--;
  var L = LESSONS[state.lesson];

  if (L.mode === 'build' || (L.mode === 'both' && state.stage === 1)) state.program = [];
  soundFail();

  if (state.lives <= 0) {
    state.hintText = '💔 Потерял все жизни! Попробуй снова.';
    state.canSkip = false;
    render();
    setTimeout(function() {
      state.lives = 5;
      state.errors = 0;
      state.program = [];
      state.hintText = '';
      state.stage = 1;
      state.fixProgram = L.broken ? L.broken.slice() : (L.stage2Broken ? L.stage2Broken.slice() : []);
      render();
    }, 1800);
    return;
  }

  if (state.errors >= 3) {
    state.hintText = L.hints[3];
    state.errors = 0;
    state.canSkip = true;
  } else {
    state.hintText = L.hints[state.errors - 1];
  }

  render();

  setTimeout(function() {
    var blocks = document.querySelectorAll('.block, .program-line');
    for (var i = 0; i < blocks.length; i++) blocks[i].classList.add('error');
    setTimeout(function() {
      var blocks2 = document.querySelectorAll('.block, .program-line');
      for (var j = 0; j < blocks2.length; j++) blocks2[j].classList.remove('error');
    }, 600);
  }, 100);
}

function skipLesson() {
  state.canSkip = false;
  nextLesson();
}

function nextLesson() {
  var next = state.lesson + 1;
  if (next < LESSONS.length) {
    startLesson(next);
  } else {
    state.screen = 'end';
    render();
  }
}

function win() {
  state.stars[state.lesson] = 1;
  state.gems += 5;
  state.streak++;
  saveProgress();
  soundWin();

  render();

  setTimeout(function() { nextLesson(); }, 1400);
}

/* ==================== ЗАПУСК ==================== */
loadProgress();
render();
</script>
</body>
</html>
