<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#58cc02">
<title>Поле</title>
<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0; padding: 0;
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--text);
    min-height: 100vh; overflow-x: hidden;
    -webkit-text-size-adjust: 100%;
    transition: background 0.3s;
    font-weight: 700;
  }

  /* === ТЕМЫ === */
  :root, body.theme-green {
    --bg: #ffffff; --text: #3c3c3c; --muted: #afafaf;
    --primary: #58cc02; --primary-dark: #46a302;
    --secondary: #1cb0f6; --secondary-dark: #1899d6;
    --accent: #ffc800; --danger: #ff4b4b;
    --card: #ffffff; --card-border: #e5e5e5;
    --locked: #e5e5e5; --locked-text: #afafaf;
    --btn-text: #ffffff; --streak: #ff9600;
  }
  body.theme-dark {
    --bg: #131f24; --text: #f1f7fb; --muted: #52656d;
    --primary: #58cc02; --primary-dark: #46a302;
    --secondary: #1cb0f6; --secondary-dark: #1899d6;
    --accent: #ffc800; --danger: #ff4b4b;
    --card: #1c2b31; --card-border: #2a3d44;
    --locked: #2a3d44; --locked-text: #52656d;
    --btn-text: #ffffff; --streak: #ff9600;
  }
  body.theme-purple {
    --bg: #f7f0ff; --text: #3c3c3c; --muted: #afafaf;
    --primary: #ce82ff; --primary-dark: #a568cc;
    --secondary: #1cb0f6; --secondary-dark: #1899d6;
    --accent: #ffc800; --danger: #ff4b4b;
    --card: #ffffff; --card-border: #e5d5f5;
    --locked: #e5d5f5; --locked-text: #afafaf;
    --btn-text: #ffffff; --streak: #ff9600;
  }

  body { display: flex; justify-content: center; }
  #app { width: 100%; max-width: 480px; padding: 0 16px 100px; min-height: 100vh; }

  /* === ВЕРХНЯЯ ПАНЕЛЬ === */
  .topbar {
    position: sticky; top: 0; z-index: 100;
    background: var(--bg);
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0; margin-bottom: 10px;
    border-bottom: 2px solid var(--card-border);
  }
  .topbar-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 18px; font-weight: 800;
  }
  .topbar-icon { font-size: 22px; }
  .topbar-hearts { color: var(--danger); }
  .topbar-streak { color: var(--streak); }
  .topbar-gems { color: var(--secondary); }

  /* === КАРТА УРОКОВ === */
  .map {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px; padding: 20px 0;
  }
  .node-wrap {
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }
  .node {
    width: 80px; height: 80px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 34px;
    background: var(--primary);
    box-shadow: 0 6px 0 var(--primary-dark);
    cursor: pointer;
    transition: transform 0.1s, box-shadow 0.1s;
    border: none; outline: none;
    color: var(--btn-text);
    position: relative;
  }
  .node:active { transform: translateY(4px); box-shadow: 0 2px 0 var(--primary-dark); }
  .node.locked {
    background: var(--locked);
    box-shadow: 0 6px 0 var(--card-border);
    color: var(--locked-text);
    cursor: not-allowed;
  }
  .node.done {
    background: var(--accent);
    box-shadow: 0 6px 0 #cc9e00;
  }
  .node-crown {
    position: absolute; top: -14px; right: -8px;
    font-size: 24px;
  }
  .node-label {
    font-size: 12px; color: var(--muted);
    margin-top: 8px; text-align: center;
    max-width: 100px;
  }
  .connector {
    width: 4px; height: 24px;
    background: var(--card-border);
    border-radius: 2px;
  }
  .connector.done { background: var(--accent); }

  /* === ЭКРАН УРОКА === */
  .progress-bar-wrap {
    height: 16px; background: var(--card-border);
    border-radius: 8px; margin: 12px 0; overflow: hidden;
  }
  .progress-bar {
    height: 100%; background: var(--primary);
    border-radius: 8px;
    transition: width 0.4s;
    box-shadow: inset 0 -4px 0 rgba(0,0,0,0.15);
  }

  h1 { font-size: 28px; text-align: center; margin: 12px 0 8px; color: var(--text); font-weight: 800; }
  h2 { font-size: 20px; margin: 8px 0; color: var(--text); font-weight: 800; }
  p { line-height: 1.5; color: var(--text); font-size: 16px; margin: 8px 0; font-weight: 600; }

  button {
    display: block; width: 100%; padding: 16px;
    font-size: 17px; border: none; border-radius: 16px;
    background: var(--primary); color: var(--btn-text);
    font-weight: 800; margin: 10px 0; cursor: pointer;
    box-shadow: 0 5px 0 var(--primary-dark);
    transition: all 0.1s; touch-action: manipulation;
    text-transform: uppercase; letter-spacing: 0.5px;
    font-family: inherit;
  }
  button:active {
    transform: translateY(4px);
    box-shadow: 0 1px 0 var(--primary-dark);
  }
  button.secondary {
    background: var(--card); color: var(--text);
    box-shadow: 0 5px 0 var(--card-border);
    border: 2px solid var(--card-border);
  }
  button.danger {
    background: var(--danger); color: white;
    box-shadow: 0 5px 0 #cc3c3c;
  }
  button.gold {
    background: var(--accent); color: #7a5c00;
    box-shadow: 0 5px 0 #cc9e00;
  }

  /* === БЛОКИ КОМАНД === */
  .block {
    padding: 18px 16px; margin: 10px 0; border-radius: 16px;
    background: var(--card);
    border: 2px solid var(--card-border);
    box-shadow: 0 4px 0 var(--card-border);
    color: var(--text);
    font-size: 16px; cursor: pointer;
    font-weight: 700;
    transition: all 0.1s;
    touch-action: manipulation; user-select: none;
    display: flex; align-items: center; gap: 10px;
  }
  .block:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--card-border); }
  .block.error {
    border-color: var(--danger);
    background: rgba(255,75,75,0.1);
    animation: shake 0.4s;
  }
  @keyframes shake {
    0%,100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-5px); }
    80% { transform: translateX(5px); }
  }
  .block-icon { font-size: 22px; }

  /* === СЛОТ ПРОГРАММЫ === */
  .slot {
    min-height: 60px; padding: 16px; margin: 12px 0; border-radius: 16px;
    background: var(--card);
    border: 3px dashed var(--card-border);
    text-align: center; font-size: 15px; color: var(--muted);
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: 6px;
  }
  .slot.filled { border-style: solid; border-color: var(--primary); color: var(--text); }
  .slot-item {
    background: var(--primary); color: white;
    padding: 6px 12px; border-radius: 10px;
    font-size: 14px; font-weight: 800;
  }

  .missing-slot {
    min-height: 60px; padding: 16px; margin: 12px 0; border-radius: 16px;
    background: rgba(255,200,0,0.15);
    border: 3px dashed var(--accent);
    text-align: center; font-size: 16px; color: #7a5c00;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
  }

  .program-line {
    padding: 16px; margin: 8px 0; border-radius: 16px;
    background: var(--card);
    border: 2px solid var(--card-border);
    box-shadow: 0 4px 0 var(--card-border);
    color: var(--text);
    font-size: 16px; text-align: center;
    font-weight: 800; user-select: none;
  }
  .program-line.clickable {
    cursor: pointer; transition: all 0.1s;
  }
  .program-line.clickable:active {
    transform: translateY(3px); box-shadow: 0 1px 0 var(--card-border);
  }
  .program-line.error {
    border-color: var(--danger);
    background: rgba(255,75,75,0.1);
    animation: shake 0.4s;
  }

  /* === ПОДСКАЗКИ === */
  .hint {
    background: rgba(28,176,246,0.1);
    border: 2px solid var(--secondary);
    border-radius: 16px;
    padding: 14px 16px; margin: 12px 0;
    font-size: 14px; color: var(--text);
    font-weight: 600;
    display: flex; gap: 10px; align-items: flex-start;
  }
  .hint-icon { font-size: 20px; flex-shrink: 0; }
  .hint-danger {
    background: rgba(255,75,75,0.1);
    border-color: var(--danger);
  }

  /* === ОБЪЯСНЕНИЕ === */
  .explain-card {
    background: var(--card);
    border: 2px solid var(--card-border);
    border-radius: 20px;
    padding: 20px;
    margin: 12px 0;
    box-shadow: 0 4px 0 var(--card-border);
  }
  .explain-card h3 {
    margin: 0 0 12px 0;
    font-size: 18px;
    color: var(--primary);
    font-weight: 800;
  }
  .example-card {
    background: rgba(255,200,0,0.1);
    border: 2px dashed var(--accent);
    border-radius: 16px;
    padding: 14px;
    margin: 12px 0;
    font-size: 15px;
    color: #7a5c00;
    font-weight: 700;
    text-align: center;
  }

  /* === СЕРДЦА И ПРОГРЕСС === */
  .hearts {
    display: flex; gap: 4px; justify-content: center;
    margin: 8px 0;
  }
  .heart { font-size: 20px; }
  .heart.empty { opacity: 0.3; }

  /* === ФИНАЛ === */
  .reward {
    text-align: center; font-size: 80px; margin: 30px 0;
    animation: pulse 1.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .stats {
    display: flex; justify-content: space-around;
    padding: 20px 0; margin: 20px 0;
    border-top: 2px solid var(--card-border);
    border-bottom: 2px solid var(--card-border);
  }
  .stat {
    text-align: center;
  }
  .stat-value {
    font-size: 28px; font-weight: 800;
    color: var(--primary);
  }
  .stat-label {
    font-size: 12px; color: var(--muted);
    font-weight: 700; margin-top: 4px;
    text-transform: uppercase;
  }

  /* === НАСТРОЙКИ === */
  .settings-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px; margin: 10px 0;
    background: var(--card);
    border: 2px solid var(--card-border);
    border-radius: 16px;
    box-shadow: 0 4px 0 var(--card-border);
  }
  .theme-btn {
    padding: 10px 14px; border-radius: 12px;
    border: 2px solid var(--card-border);
    background: var(--bg);
    color: var(--text);
    cursor: pointer; font-size: 14px;
    font-weight: 800;
    margin: 0 4px;
  }
  .theme-btn.active {
    border-color: var(--primary);
    background: rgba(88,204,2,0.1);
    color: var(--primary);
  }
  .theme-row {
    display: flex; gap: 6px; justify-content: center;
    margin-top: 10px; flex-wrap: wrap;
  }

  .center { text-align: center; }
  .desc { text-align: center; font-size: 15px; color: var(--muted); margin: 8px 10px; line-height: 1.5; font-weight: 600; }

  .back-btn {
    background: transparent; color: var(--muted);
    box-shadow: none; font-size: 14px;
    padding: 12px 0; margin-bottom: 4px;
    text-align: left; text-transform: none;
    letter-spacing: 0;
  }
  .back-btn:active { transform: none; box-shadow: none; }

  @media (max-width: 360px) {
    h1 { font-size: 24px; }
    .node { width: 70px; height: 70px; font-size: 30px; }
  }
</style>
